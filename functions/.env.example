# BOS is disabled unless this is explicitly true.
BOS_ENABLED=false
BOS_EVENTS_ENDPOINT=https://bos.example.invalid/v1/integration-events
BOS_INTEGRATION_ID=replace-with-bos-issued-integration-id
BOS_INTEGRATION_SECRET=replace-locally-or-use-firebase-secret-manager
BOS_ENVIRONMENT=development
BOS_TIMEOUT_MS=5000
BOS_MAX_ATTEMPTS=3
BOS_RETRY_BASE_DELAY_MS=250
